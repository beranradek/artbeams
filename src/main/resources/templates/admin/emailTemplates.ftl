<#import "/adminLayout.ftl" as layout><#import "/adminComponents.ftl" as c>
<@layout.page><@c.pageHeader title="E-mail templates"/>
<p class="text-muted">Use <code>{{variable}}</code>. Values are escaped in the HTML body. System templates can be edited but not deleted.</p>
<#list templates as template><div class="card mb-3"><div class="card-body"><form action="/admin/email-templates/${template.id}/update" method="post"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/><h3>${template.templateKey?html}<#if template.systemTemplate> <small class="text-muted">system</small></#if></h3><input class="form-control mb-2" name="subject" maxlength="500" required value="${template.subject?html}"/><textarea class="form-control mb-2" name="bodyHtml" rows="10" required>${template.bodyHtml?html}</textarea><button class="btn btn-primary btn-sm">Save</button></form><#if !template.systemTemplate><form class="mt-2" action="/admin/email-templates/${template.id}/delete" method="post" data-confirm="Delete this email template?"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/><button class="btn btn-outline-danger btn-sm">Delete</button></form></#if></div></div><#else><p>No templates.</p></#list>
<h2>Add template</h2><form action="/admin/email-templates/add" method="post"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/><input class="form-control mb-2" name="templateKey" pattern="[a-z0-9-]+" maxlength="80" placeholder="template-key" required/><input class="form-control mb-2" name="subject" maxlength="500" placeholder="Subject" required/><textarea class="form-control mb-2" name="bodyHtml" rows="8" placeholder="HTML body" required></textarea><button class="btn btn-primary">Add</button></form></@layout.page>
